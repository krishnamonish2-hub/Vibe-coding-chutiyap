{
  "package_version": "1.0.0",
  "model_name": "MessMind dish-demand model",
  "model_version": "rf-v1-synthetic",
  "model_type": "RandomForestRegressor (scikit-learn)",
  "task": "Predict how many students will actually eat each dish at one meal (dish-wise, not total attendance).",
  "target": {
    "name": "actual_dish_consumers",
    "type": "int",
    "range": "[0, total_students]",
    "note": "interested_taps is an INPUT; actual consumers are the target"
  },
  "status": {
    "selection": "FROZEN",
    "frozen_on": "2026-11-14",
    "selected_on": "validation results only (Phases 5-6)"
  },
  "trained_on": "synthetic",
  "synthetic_data_limitation": "Trained and evaluated ONLY on synthetic data from src/generate_data.py. Metrics show how well the simulator's rules are learned, not accuracy in a real mess. Retrain and re-test on real exported records (shared/api_contract.md section 3) before using predictions for real cooking decisions.",
  "hyperparameters": {
    "n_estimators": 500,
    "max_depth": 12,
    "min_samples_split": 2,
    "min_samples_leaf": 1,
    "max_features": 1.0
  },
  "random_state": 42,
  "features": {
