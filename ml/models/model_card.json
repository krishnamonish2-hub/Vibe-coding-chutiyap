      "dish_name_Egg Curry",
      "dish_name_Gulab Jamun",
      "dish_name_Ice Cream",
      "dish_name_Idli Sambar",
      "dish_name_Kadai Paneer",
      "dish_name_Kadhi",
      "dish_name_Kheer",
      "dish_name_Lauki Sabzi",
      "dish_name_Masala Dosa",
      "dish_name_Mixed Veg",
      "dish_name_Palak Paneer",
      "dish_name_Paneer Butter Masala",
      "dish_name_Poha",
      "dish_name_Rajma",
      "dish_name_Rice",
      "dish_name_Salad",
      "dish_name_Soya Chunks",
      "dish_name_Tea",
      "dish_name_Upma",
      "dish_name_Veg Biryani",
      "dish_name_Vegetable Soup"
    ],
    "groups": {
      "history": [
        "historical_dish_demand",
        "historical_dish_rating",
        "previous_leftover_kg"
      ],
      "numeric": [
        "day_of_week",
        "temperature",
        "rainfall",
        "previous_meal_attendance",
        "interested_taps",
        "total_responses",
        "tap_share",
        "response_rate",
        "projected_interest",
        "num_dishes_in_meal"
      ],
      "boolean": [
        "is_weekend",
        "is_holiday",
        "is_exam_day",
        "is_festival",
        "is_new_dish"
      ],
      "categorical": [
        "meal_type",
        "dish_category",
        "dish_name"
      ]
    },
    "excluded": {
      "actual_dish_consumers": "the TARGET (known only after the meal) - kept separately as y",
      "data_source": "metadata, always 'synthetic'",
      "date": "identifier / split key; raw dates do not generalise to future days (useful parts are already columns: day_of_week, calendar flags)",
      "total_students": "constant (1000) in this data, so no information as a raw column; used only inside response_rate and projected_interest",
      "month (not derived)": "train covers Jul-Aug (+1 Sep day) while test is entirely September: the model would have to extrapolate an unseen month value",
      "dish_times_served_before (not derived)": "cannot be computed correctly - servings before the CSV window (generator warm-up) are not in the data"
    }
  },
  "input_spec": {
    "date": {
      "type": "date YYYY-MM-DD",
      "required": true
    },
    "meal_type": {
      "type": "category",
      "required": true,
      "allowed": [
        "breakfast",
        "lunch",
        "dinner"
      ]
    },
    "dish_name": {
      "type": "string",
      "required": true,
      "unseen": "allowed (falls back to dish_category)"
    },
    "dish_category": {
      "type": "category",
      "required": true,
      "unseen": "allowed (encoded as all zeros)"
    },
    "total_students": {
      "type": "int",
      "required": true,
      "rule": "> 0"
    },
    "total_responses": {
      "type": "int",
      "required": true,
      "rule": "0 <= x <= total_students; same for every dish of a meal"
    },
    "interested_taps": {
      "type": "int",
      "required": true,
      "rule": "0 <= x <= total_responses"
    },
    "is_holiday": {
      "type": "bool",
      "required": false,
      "default": false
    },
    "is_exam_day": {
      "type": "bool",
      "required": false,
      "default": false
    },
    "is_festival": {
      "type": "bool",
      "required": false,
      "default": false
    },
    "day_of_week": {
      "type": "int 0-6",
      "required": false,
      "default": "derived from date (must match if given)"
    },
    "is_weekend": {
      "type": "bool",
      "required": false,
      "default": "derived from date (must match if given)"
    },
    "temperature": {
      "type": "float degC",
      "required": false,
      "rule": "-30..60",
      "if_missing": "train median"
    },
    "rainfall": {
      "type": "float mm",
      "required": false,
      "rule": ">= 0",
      "if_missing": "train median"
    },
    "previous_meal_attendance": {
      "type": "float",
      "required": false,
      "rule": "0..total_students",
      "if_missing": "train median"
    },
    "historical_dish_demand": {
      "type": "float",
      "required": false,
      "rule": ">= 0; mean of last 5 PAST servings",
      "if_missing": "treated as NEW dish: is_new_dish=1 + train median of (dish_category, meal_type)"
    },
    "historical_dish_rating": {
      "type": "float",
      "required": false,
      "rule": "1..5; mean of last 5 PAST ratings",
      "if_missing": "train median of (dish_category, meal_type)"
    },
    "previous_leftover_kg": {
      "type": "float",
      "required": false,
      "rule": ">= 0; this dish, previous serving",
      "if_missing": "train median of (dish_category, meal_type)"
    }
  },
  "training_ranges": {
    "total_students": {
      "min": 1000.0,
      "max": 1000.0
    },
    "total_responses": {
      "min": 232.0,
      "max": 575.0
    },
    "interested_taps": {
      "min": 30.0,
      "max": 422.0
    },
    "historical_dish_demand": {
      "min": 117.6,
      "max": 732.2
    },
    "actual_dish_consumers": {
      "min": 91.0,
      "max": 830.0
    }
  },
  "preprocessing": {
    "steps": [
      "engineer: stateless pre-meal features (tap_share, response_rate, projected_interest, num_dishes_in_meal, is_new_dish)",
      "history: GroupMedianImputer - train medians per (dish_category, meal_type) -> meal_type -> overall",
      "numeric: SimpleImputer(median), fitted on train",
      "boolean: SimpleImputer(most_frequent), fitted on train",
      "categorical: SimpleImputer('unknown') + OneHotEncoder(handle_unknown='ignore'), fitted on train",
      "no scaling (tree model)"
    ],
    "fitted_on": "train split only; never refitted at inference"
  },
  "postprocessing": "round to nearest integer, then clip to [0, total_students]",
  "dataset": {
    "id": "messmind-synthetic-v1",
    "data_source": "synthetic",
    "generator": "src/generate_data.py",
    "generator_args": "--days 90 --students 1000 --seed 42 --start-date 2026-07-01 --burn-in-days 21",
    "raw_data_md5": "0a8d9df2a9491ef15e86d93a71c3bf3c",
