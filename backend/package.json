{
  "name": "messmind-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MessMind main backend (Express + PostgreSQL). Calls the independent ML service; never modifies ml/.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.js",
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "migrate": "node --env-file-if-exists=../.env src/db/migrate.js",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "supertest": "7.3.2",
    "vitest": "5.1.0"
  }
}
