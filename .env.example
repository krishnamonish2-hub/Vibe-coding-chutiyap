# MessMind local configuration. Copy to `.env` at the repository root (never commit `.env`).
# Both backend/ and frontend/ read this file.

# ---- Backend (Express) ----
PORT=4000
# PostgreSQL connection string (local development database).
DATABASE_URL=postgres://messmind:change-me@127.0.0.1:5432/messmind
# Independent ML service (ml/), started with its existing setup. Backend-only; never exposed to the browser.
ML_API_URL=http://127.0.0.1:8001
ML_TIMEOUT_MS=10000

# ---- Frontend (Vite dev server proxy target for /api) ----
VITE_BACKEND_URL=http://127.0.0.1:4000

# Session signing key: REQUIRED, at least 32 random characters, e.g. `openssl rand -base64 48`.
# Left empty on purpose: the server refuses to start until you set your own value.
JWT_SECRET=
SESSION_TTL_HOURS=8
# Secure cookies need HTTPS. Leave false for local http development.
COOKIE_SECURE=false

# ---- Seed accounts (npm run seed). Leave a pair empty to skip that account. Passwords: 12+ characters. ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The demo student is always linked to synthetic student S0001.
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=

# ---- Added in later phases ----
# ML_LIVE_TESTS=1        # Phase 5: run the live ML contract test (needs the ML service running)
