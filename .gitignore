# ===== MessMind repository-wide ignores =====

# Virtual environments
venv/
.venv/
env/
ENV/

# Python caches / build output
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Secrets and local configuration (never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials.*

# Node (in case a frontend is added later)
node_modules/

# OS / editor clutter
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log
.vscode/
.idea/
